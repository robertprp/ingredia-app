# iOS Simulator and web. For Android Emulator use http://10.0.2.2:3000.
# For a physical device, use your computer's LAN URL or an HTTPS tunnel.
EXPO_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# Optional when the verification endpoint is hosted separately. This is a public URL, not a secret.
# Defaults to EXPO_PUBLIC_BETTER_AUTH_URL + /api/verification/start.
# EXPO_PUBLIC_DIDIT_SESSION_URL=https://api.example.com/api/verification/start
