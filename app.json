{
  "expo": {
    "name": "nooveller",
    "slug": "nooveller",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "nooveller",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.nooveller.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.nooveller.app",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F4EE",
          "dark": {
            "backgroundColor": "#1C1C1E"
          }
        }
      ],
      "@didit-protocol/sdk-react-native",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6ba25c17-645d-4adc-83aa-4c1f3b32ed13"
      }
    },
    "owner": "noovellers-team"
  }
}
